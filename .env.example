# ============================================
# JETOUR ECUADOR - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo a .env.local para desarrollo
# y configurar en Vercel para producción.

# --- SANITY CMS ---
# Nuevo project ID bajo cuenta de Jetour (Fase 1)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Opcional. Default en sanity/env.js es '2025-10-18'
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-18

# --- GOOGLE MAPS ---
# Usado en /concesionarios y /posventa para mostrar ubicaciones.
# Restringir por dominio (jetourecuador.com, *.vercel.app de staging)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- PRISMA / POSTGRESQL ---
# Conexión a la base de datos de formularios (contacts, quotes, service_submissions).
# Formato: postgresql://user:password@host:port/database
# Recomendado: Vercel Postgres (incluido en plan Pro, sin costo adicional).
DATABASE_URL=
